{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "declaration": true,
        "declarationDir": "./dist",
        "emitDeclarationOnly": false,
        "outDir": "./dist"
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/**/*.stories.tsx",
        "src/**/*.stories.ts",
        "**/*.test.tsx",
        "**/*.test.ts",
        ".storybook"
    ],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}